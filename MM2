local function updateWeaponCache(plr)
    if plr == LocalPlayer then weaponCache[plr] = nil return end
    local found = nil
    local function check(item)
        if item:IsA("Tool") then
            local n = string.lower(item.Name)
            if string.find(n, "knife") or string.find(n, "murderer") then found = "Knife"
            elseif string.find(n, "gun") or string.find(n, "revolver") or string.find(n, "sheriff") then found = "Gun" end
        end
    end
    local bp = plr:FindFirstChild("Backpack")
    if bp then for _, v in ipairs(bp:GetChildren()) do check(v) if found then break end end end
    if not found and plr.Character then for _, v in ipairs(plr.Character:GetChildren()) do check(v) if found then break end end end
    weaponCache[plr] = found
end

local function getPlayerColor(plr)
    local t = weaponCache[plr]
    if t == "Knife" then return State.ESP.KnifeColor, plr.Name .. " [Knife]", "Knife"
    elseif t == "Gun" then return State.ESP.GunColor, plr.Name .. " [Gun]", "Gun"
    else return State.ESP.NoneColor, plr.Name .. " [None]", "None" end
end

local function removeESP(plr)
    if espObjects[plr] then
        pcall(function() espObjects[plr].Highlight:Destroy() end)
        pcall(function() espObjects[plr].Frame:Destroy() end)
        espObjects[plr] = nil
    end
end

local function clearAllESP()
    for plr in pairs(espObjects) do removeESP(plr) end
    weaponCache = {}
end

local function createESP(plr)
    removeESP(plr)
    if not plr.Character then return end
    local color, displayText, itemType = getPlayerColor(plr)
    if (itemType == "Gun" and not State.ESP.showGun) or
       (itemType == "Knife" and not State.ESP.showKnife) or
       (itemType == "None" and not State.ESP.showNone) then return end

    local hl = Instance.new("Highlight")
    hl.Parent = plr.Character
    hl.FillColor = color
    hl.FillTransparency = State.ESP.FillTrans
    hl.OutlineColor = color
    hl.OutlineTransparency = State.ESP.OutlineTrans
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop

    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(0, 200, 0, 28)
    frame.BackgroundTransparency = 1
    frame.Parent = espScreenGui

    local txt = Instance.new("TextLabel")
    txt.Size = UDim2.new(1, 0, 1, 0)
    txt.BackgroundTransparency = 1
    txt.Text = displayText
    txt.TextColor3 = color
    txt.TextSize = 14
    txt.Font = Enum.Font.GothamBold
    txt.TextStrokeTransparency = 0.2
    txt.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    txt.TextXAlignment = Enum.TextXAlignment.Center
    txt.Parent = frame

    espObjects[plr] = {Highlight = hl, Frame = frame}
end

local function updateESP()
    if not State.ESP.enabled then clearAllESP() return end
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            updateWeaponCache(plr)
        end
    end
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LocalPlayer then continue end
        if not plr.Character then removeESP(plr) continue end
        local color, _, itemType = getPlayerColor(plr)
        local shouldShow = not (
            (itemType == "Gun" and not State.ESP.showGun) or
            (itemType == "Knife" and not State.ESP.showKnife) or
            (itemType == "None" and not State.ESP.showNone)
        )
        if shouldShow then
            if not espObjects[plr] then
                createESP(plr)
            else
                local hl = espObjects[plr].Highlight
                if hl and hl.FillColor ~= color then createESP(plr) end
                if hl then
                    hl.FillTransparency = State.ESP.FillTrans
                    hl.OutlineTransparency = State.ESP.OutlineTrans
                end
            end
        else
            removeESP(plr)
        end
    end
    for plr in pairs(espObjects) do
        if not Players:FindFirstChild(plr.Name) then removeESP(plr) end
    end
end

