local function switchTab(name)
    for n, p in pairs(Pages) do p.Visible = (n == name) end
    for n, b in pairs(tabBtns) do
        b.BackgroundColor3 = (n == name) and Color3.fromRGB(30, 20, 50) or Color3.fromRGB(12, 10, 18)
        b.TextColor3 = (n == name) and Color3.fromRGB(200, 160, 255) or Color3.fromRGB(110, 90, 150)
    end
    currentPage = name
end

