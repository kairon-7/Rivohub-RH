addToggle(vPage, "Remove All Effects", false, function(v)
    State.Visuals.removeEffects = v
    if v then
        removeEffects()
        if not effectsConn then
            effectsConn = workspace.DescendantAdded:Connect(function(obj)
                if State.Visuals.removeEffects and (obj:IsA("ParticleEmitter") or obj:IsA("Trail") or
                   obj:IsA("Beam") or obj:IsA("Fire") or obj:IsA("Smoke") or obj:IsA("Sparkles")) then
                    pcall(function() obj:Destroy() end)
                end
            end)
        end
    else
        if effectsConn then effectsConn:Disconnect() effectsConn = nil end
    end
end)
addToggle(vPage, "Monochrome World", false, function(v)
    State.Visuals.monoEnabled = v
    if v then
        for _, obj in ipairs(workspace:GetDescendants()) do applyMono(obj) end
        if monoListener then monoListener:Disconnect() end
        monoListener = workspace.DescendantAdded:Connect(function(obj)
            if State.Visuals.monoEnabled and obj:IsA("BasePart") and not isPlayerPart(obj) then
                applyMono(obj)
            end
        end)
    else
        if monoListener then monoListener:Disconnect() monoListener = nil end
        restoreMono()
    end
end)
