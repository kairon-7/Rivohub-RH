local function removeEffects()
    local lighting = game:GetService("Lighting")
    for _, c in ipairs(lighting:GetChildren()) do
        if c:IsA("Atmosphere") or c:IsA("BloomEffect") or c:IsA("ColorCorrectionEffect") or
           c:IsA("SunRaysEffect") or c:IsA("DepthOfFieldEffect") or c:IsA("BlurEffect") then
            pcall(function() c:Destroy() end)
        end
    end
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam") or
           obj:IsA("Fire") or obj:IsA("Smoke") or obj:IsA("Sparkles") then
            pcall(function() obj:Destroy() end)
        end
    end
end

local function isPlayerPart(part)
    local model = part:FindFirstAncestorOfClass("Model")
    return model and Players:GetPlayerFromCharacter(model) ~= nil
end

local function applyMono(part)
    if not part:IsA("BasePart") or isPlayerPart(part) then return end
    if not monoData[part] then monoData[part] = {Color = part.Color, Material = part.Material} end
    local g = (part.Color.R + part.Color.G + part.Color.B) / 3 * 0.22
    part.Color = Color3.new(g, g, g)
    part.Material = Enum.Material.Plastic
end

local function restoreMono()
    for part, data in pairs(monoData) do
        if part and part.Parent then
            part.Color = data.Color
            part.Material = data.Material
        end
    end
    monoData = {}
end

local function applyTransToChar(char, t)
    if not char then return end
    for _, p in ipairs(char:GetDescendants()) do
        if p:IsA("BasePart") and p.Name ~= "HumanoidRootPart" then p.Transparency = t end
    end
end

local function applyAllTrans()
    if not State.Visuals.transEnabled then
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr.Character then
                for _, p in ipairs(plr.Character:GetDescendants()) do
                    if p:IsA("BasePart") and p.Name ~= "HumanoidRootPart" then p.Transparency = 0 end
                end
            end
        end
        return
    end
    for _, plr in ipairs(Players:GetPlayers()) do
        local t = (plr == LocalPlayer) and State.Visuals.selfTrans or State.Visuals.otherTrans
        applyTransToChar(plr.Character, t)
    end
end

local function applyFog()
    local l = game:GetService("Lighting")
    if State.Visuals.fogEnabled then
        l.FogEnd = State.Visuals.fogEnd
        l.FogStart = 0
        l.FogColor = State.Visuals.fogColor
    else
        l.FogEnd = 100000
        l.FogStart = 0
        l.FogColor = Color3.fromRGB(192, 192, 192)
    end
end

